# Register
POST http://localhost:8001/api/auth/register/
Content-Type: application/json

{
  "email": "test@example.com",
  "username": "testuser",
  "password": "TestPassword123!",
  "password_confirm": "TestPassword123!",
  "phone_number": "+1234567890",
  "recaptcha_token": "your-recaptcha-token"
}

###

# Login
POST http://localhost:8001/api/auth/login/
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "TestPassword123!",
  "recaptcha_token": "your-recaptcha-token"
}

###

# Verify OTP
POST http://localhost:8000/api/auth/verify-otp/
Content-Type: application/json

{
  "firebase_id_token": "your-firebase-id-token",
  "phone_number": "+1234567890"
}

###

# Google OAuth
POST http://localhost:8000/api/auth/google-oauth/
Content-Type: application/json

{
  "id_token": "your-google-id-token",
  "email": "test@example.com",
  "name": "Test User"
}

###

# Password Reset
POST http://localhost:8000/api/auth/password-reset/
Content-Type: application/json

{
  "email": "test@example.com"
}

###

# Logout
POST http://localhost:8000/api/auth/logout/
Content-Type: application/json
Authorization: Bearer your-access-token
Cookie: refresh_token=your-refresh-token

{}

###

# Token Refresh
POST http://localhost:8000/api/auth/token/refresh/
Content-Type: application/json
Cookie: refresh_token=your-refresh-token

{}

###

# User Profile
GET http://localhost:8000/api/auth/user/
Content-Type: application/json
Authorization: Bearer your-access-token